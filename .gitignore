# --- credentials: never commit ---
kaggle.json
access_token
*.pem
.env

# --- local config (holds your Kaggle username) ---
config.json

# --- derived per-video files (regenerated on demand) ---
videos/*/state.json
videos/*/flow_prompts.txt

# --- heavy build artefacts ---
videos/*/flow/*.mp4
videos/*/flow/*.mov
videos/*/body/stills/
videos/*/body/clips/
videos/*/body/_work/
videos/*/body/footage/
videos/*/body/footage_zip/
build/
videos/*/body/photos/
videos/*/body/kaggle_out/
videos/*/body/voice/
videos/*/out/
videos/*/voice/*.flac
videos/*/voice/*.wav
*.mp4
*.mkv
*.wav
*.flac
*.zip
!assets/music/*.mp3

# --- python ---
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Kokoro voice model files -- ~310 MB and ~26 MB, fetched from the
# kokoro-onnx GitHub releases page. Shared by every video, never committed.
kokoro-*.onnx
voices-*.bin
